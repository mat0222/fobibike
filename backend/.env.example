# Servidor
PORT=3001
NODE_ENV=development

# Base de datos — MySQL Server 8.0 (MySQL Workbench)
# Importá fobibike_db.sql con scripts/import-database.ps1
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=tu_contraseña_mysql
DB_NAME=fobibike_db

# Seguridad — CAMBIAR en producción (mínimo 32 caracteres aleatorios)
JWT_ACCESS_SECRET=cambiar_por_secreto_largo_y_aleatorio_minimo_32_chars
JWT_REFRESH_SECRET=cambiar_otro_secreto_distinto_minimo_32_chars

# Frontend permitido (CORS)
FRONTEND_URL=http://localhost:5173

# Fobi (chatbot con IA)
# groq = IA real gratis (recomendado) | openai = de pago | local = sin IA
CHAT_PROVIDER=groq

# Groq — gratis, sin tarjeta: https://console.groq.com/keys
GROQ_API_KEY=gsk_tu_api_key_aqui
GROQ_MODEL=llama-3.3-70b-versatile

# OpenAI — de pago: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
